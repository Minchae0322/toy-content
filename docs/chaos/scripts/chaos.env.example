# chaos.env.example — 복사해서 chaos.env로 저장 후 실제 값 기입.
# chaos.env는 .gitignore에 등록되어 있다 (시크릿·사설 IP 포함 — 절대 커밋 금지).
# 값 확인 절차는 docs/chaos/RUNBOOK.md §10 Step 0 참조.

## ── 접속 ──────────────────────────────────────────────
# 인프라 노드 (redis/kafka/mongo docker). master에서 닿는 SSH 한 줄.
INFRA_SSH="ssh -i ~/KEY.pem ubuntu@10.0.0.0"

## ── 클러스터 (Step 0의 live 이름으로) ─────────────────
NS=default
CONTENT_DEPLOY=content-service
AUTH_DEPLOY=auth-service
CHAT_DEPLOY=chat-service
CONTENT_SECRET=content-secret
AUTH_CPU_NORMAL=500m          # AU-1 원복값 — live 스펙(kubectl get deploy -o yaml)으로 확인 후 고정

## ── 인프라 컨테이너 이름 ($INFRA_SSH "docker ps --format '{{.Names}}'") ──
REDIS_CT=
KAFKA_CT=
MONGO_CT=

## ── API ───────────────────────────────────────────────
BASE=https://yogurtte.com/api
EMAIL=                        # 테스트 계정 (실사용자 금지, k6 시드 계정 재사용 가능)
PASSWORD=
BATTLE_ID=                    # §3.2에서 선정. 반드시 실존 ID + 트리거 계정과 다른 소유자(self-skip 시 알림 미발행)
ITEM_ID=                      # 주의: 미실존 ID여도 CDN이 404를 SPA 200으로 마스킹해 성공처럼 보임 — 게이트가 JSON 검사로 잡아줌
FEED_ID=                      # AP-1/AP-3 댓글 대상 피드 (내가 만든 테스트 피드 권장)
RECIPIENT_EMAIL=              # 알림 수신자(=아이템 소유 계정) — 설정 시 CH-1이 알림함 도착/미도착 자동 확인
RECIPIENT_PASSWORD=

## ── Grafana Cloud 데이터소스 API ──────────────────────
# 지름길: 노드의 Alloy 설정에 URL·username이 이미 있다 — remote-write URL에서 /push류 접미사만 제거.
#   prometheus: .../api/prom/push → PROM_URL=.../api/prom
#   loki:       .../loki/api/v1/push → LOKI_URL=호스트만
# 없으면 grafana.com 포털 → 스택 → 각 제품 Details에서 URL과 User(숫자 instance ID) 확인.
# GRAFANA_TOKEN은 새로 발급: 포털 → Security → Access Policies → metrics:read, logs:read, traces:read
# (Alloy가 쓰는 토큰은 write 전용일 수 있어 재사용 불가할 가능성 높음)
# 검증: curl -s -u "$PROM_USER:$GRAFANA_TOKEN" -G "$PROM_URL/api/v1/query" --data-urlencode 'query=up' | jq '.status'
PROM_URL=https://prometheus-prod-XX-XXX.grafana.net/api/prom
PROM_USER=
LOKI_URL=https://logs-prod-XXX.grafana.net
LOKI_USER=
TEMPO_URL=https://tempo-prod-XX-XXX.grafana.net   # /api/search가 404면 뒤에 /tempo를 붙여볼 것
TEMPO_USER=
GRAFANA_TOKEN=

## ── k6 (IN-3) ─────────────────────────────────────────
K6_SCRIPT=../../../k6/single-test.js

## ── CH-3 (Mongo 짧은 다운 → 지연 흡수) ────────────────
# 다운 유지 시간(초). 드라이버 서버 셀렉션 대기 상한(serverSelectionTimeoutMS 기본 30s)
# **미만**이어야 예외가 나지 않아 지연 갈래가 성립한다. 30 이상이면 chaos.sh가 거부한다.
# 20~25 권장: 30s 경계 마진 확보 + 공백이 자식 span 합(~1s)의 20배라 관측이 뚜렷하다.
CH3_DOWN_SECONDS=20
